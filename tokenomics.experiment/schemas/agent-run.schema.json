{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandersouza/grafanaFastMCP/tokenomics/agent-run.schema.json",
  "title": "Normalized Agent Tokenomics Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "branch",
    "task_id",
    "stage",
    "message_index",
    "input_tokens",
    "output_tokens",
    "reasoning_tokens",
    "total_tokens",
    "elapsed_seconds",
    "human_prompt_count",
    "files_changed",
    "repeated_file_edits",
    "test_loop_count",
    "lint_loop_count",
    "result",
    "source_file"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "DESIGN",
        "CODING",
        "CODE_COMPLETION",
        "CODE_REVIEW",
        "TESTING",
        "DOCUMENTATION",
        "UNKNOWN"
      ]
    },
    "message_index": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "reasoning_tokens": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "human_prompt_count": {
      "type": "integer",
      "minimum": 0
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repeated_file_edits": {
      "type": "integer",
      "minimum": 0
    },
    "test_loop_count": {
      "type": "integer",
      "minimum": 0
    },
    "lint_loop_count": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "enum": ["pass", "fail", "invalid", "unknown"]
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    }
  }
}

